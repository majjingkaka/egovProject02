<mapper namespace="bibleMember">
	
	<insert id="insertBibleMember" parameterType="bibleMemberVO">
	/* bibleMember.insertBibleMember */
		INSERT INTO COMTNGNRLMBER(
			MBER_ID,
			MBER_NM,
			PASSWORD,
			ESNTL_ID,
			CHURCH_NM,
			MBER_AGE,
			DUTY_CD,
			MBER_STTUS,
			ZIP,
			ADRES,
			DETAIL_ADRES,
			AREA_NO,
			MIDDLE_TELNO,
			END_TELNO,
			MBTLNUM,
			MBER_EMAIL_ADRES,
			SBSCRB_DE
			)
		VALUES( 
			#{userId},
			#{userNm},
			#{password},
			#{uniqId},
			#{churchNm},
			#{mberAge},
			#{dutyCd},
			#{mberSttus},
			#{zip},
			#{adres},
			#{detailAdres},
			#{areaNo},
			#{middleTelno},
			#{endTelno},
			concat(#{areaNo},'-',#{middleTelno},'-',#{endTelno}),
			concat(#{email},'@',#{emailDomain}),
			sysdate()
			)
	</insert>
	
		
	<insert id="insertBibleMemberAuth" parameterType="bibleMemberVO">
	/* bibleMember.insertBibleMember */
			INSERT INTO COMTNEMPLYRSCRTYESTBS 
				  ( SCRTY_DTRMN_TRGET_ID
                  , MBER_TY_CODE
				  , AUTHOR_CODE)
		   VALUES ( #{uniqId}
                  , #{mberTyCode}
                  , #{authorCode})
	</insert>
	
	
	
	
	
